  "components": {
    "schemas": {
      "Agreement": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "signature": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Signature"
          },
          "agreed": {
            "type": "boolean",
            "title": "Agreed"
          },
          "disclosure_version": {
            "type": "string",
            "maxLength": 80,
            "title": "Disclosure Version"
          },
          "document_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Document Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "signature",
          "agreed",
          "disclosure_version",
          "document_hash"
        ],
        "title": "Agreement"
      },
      "Code": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 6,
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Code"
      },
      "Confirm": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          },
          "code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 6,
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password",
          "code"
        ],
        "title": "Confirm"
      },
      "Connect": {
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Device Id"
          },
          "server_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "title": "Server Id",
            "default": "auto"
          },
          "adblock": {
            "type": "boolean",
            "title": "Adblock",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "device_id"
        ],
        "title": "Connect"
      },
      "Device": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Label"
          },
          "public_key": {
            "type": "string",
            "maxLength": 44,
            "minLength": 44,
            "title": "Public Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "public_key"
        ],
        "title": "Device"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          },
          "code": {
            "type": "string",
            "maxLength": 100,
            "title": "Code",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Signup": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,32}$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "signature": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Signature"
          },
          "agreed": {
            "type": "boolean",
            "title": "Agreed"
          },
          "disclosure_version": {
            "type": "string",
            "maxLength": 80,
            "title": "Disclosure Version"
          },
          "document_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Document Hash"
          },
          "invitation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Invitation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password",
          "name",
          "signature",
          "agreed",
          "disclosure_version",
          "document_hash"
        ],
        "title": "Signup"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
